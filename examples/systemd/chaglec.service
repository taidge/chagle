[Unit]
Description=Chagle Client Service
After=network.target

[Service]
Type=simple
Restart=on-failure
RestartSec=5s
LimitNOFILE=1048576

# with root
ExecStart=/usr/bin/chagle -c /etc/chagle/chagle.toml
# without root
# ExecStart=%h/.local/bin/chagle -c %h/.local/etc/chagle/chagle.toml

[Install]
WantedBy=multi-user.target
